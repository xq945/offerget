# 本地覆盖配置示例：
# 复制为 application-local.yml 后按需修改，该文件已被 .gitignore 忽略。
# 不创建此文件时，application.yml 中的默认值同样可以启动。
spring:
  datasource:
    username: root
    password: offerget123

app:
  jwt:
    # 生产环境务必替换为随机生成的 32 字节以上字符串
    secret: replace-with-a-random-secret-at-least-32-bytes
  cors:
    allowed-origins: http://localhost:5175
  file:
    storage-root: ./uploads
  ai:
    deepseek:
      # 在 https://platform.deepseek.com 创建，只填在本地文件或环境变量里
      api-key: sk-your-deepseek-api-key
